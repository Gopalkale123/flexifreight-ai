# AI Model API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=flexifreight-ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5433/flexifreight-ai

# Application Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps Platform API Key (Distance Matrix API & Directions API)
# Optional: If omitted, the Distance Agent automatically uses the High-Precision Geodesic Road Engine.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
